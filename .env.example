# ==============================================================================
# AI-BASED SMART PARKING MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Flask Core Security & Environment
SECRET_KEY=smart-parking-ai-secret-2026
FLASK_ENV=development
DEBUG=True

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=smart_parking

# Simulation & Penalty Defaults
SIMULATION_OFFSET=0
DEFAULT_GRACE_PERIOD_MINUTES=15
DEFAULT_CAR_PENALTY=60.0
DEFAULT_BIKE_PENALTY=30.0
DEFAULT_OTHER_PENALTY=80.0

# ==============================================================================
# EMAIL SERVICE CONFIGURATION (Native Python SSL/TLS Secure Transport)
# Nodemailer Parity:
#   - Port 465 : Direct SSL/TLS connection (smtplib.SMTP_SSL)   -> secure: true
#   - Port 587 : STARTTLS upgrade connection (smtplib.SMTP)     -> secure: false
# ==============================================================================

# Common Provider Defaults:
# Gmail:
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=465 (with MAIL_SECURE=true) OR 587 (with MAIL_SECURE=false)
#   Note: Use Google "App Password" if 2-Step Verification is active.
#
# Outlook / Office 365:
#   MAIL_SERVER=smtp.office365.com
#   MAIL_PORT=587
#   MAIL_SECURE=false
#
# SendGrid:
#   MAIL_SERVER=smtp.sendgrid.net
#   MAIL_PORT=587 (or 465)
#   MAIL_USERNAME=apikey
#   MAIL_PASSWORD=<your-sendgrid-api-key>

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Nodemailer parity: Set to true for Port 465 (direct SSL/TLS), false for Port 587 (STARTTLS)
# If omitted, auto-detected from MAIL_PORT (465 -> true, 587 -> false)
MAIL_SECURE=false

# Specific flags if needed (MAIL_SECURE takes precedence):
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# SMTP Authentication credentials
MAIL_USERNAME=
MAIL_PASSWORD=

# Sender Details
MAIL_DEFAULT_SENDER=Smart Parking AI <noreply@smartparking.ai>
MAIL_DEFAULT_SENDER_NAME=Smart Parking AI
MAIL_DEFAULT_SENDER_EMAIL=noreply@smartparking.ai
MAIL_REPLY_TO=support@smartparking.ai

# Network and Threading
MAIL_TIMEOUT=15
MAIL_MAX_WORKERS=4

# Set to 'true' in development to log email content to console/outbox without connecting to SMTP
MAIL_SUPPRESS_SEND=false
MAIL_DEBUG=false

